      {
        tag: "movement_costs",
        flat: 1,
        forest: 2,
        hills: 2,
        village: 1,
      },
      {
        tag: "defense",
        flat: 60,
        forest: 50,
        hills: 50,
        village: 40,
      },
      {
        tag: "resistance",
        blade: 100,
        pierce: 100,
        impact: 100,
        arcane: 90,
      },
    ],
  },
  {
    tag: "weapon_special",
    id: "firststrike",
    name: _("firststrike"),
  },
  {
    tag: "unit_type",
    id: "Spearman",
    name: _("Spearman"),
    image: "units/humans/spearman.png",
    hitpoints: 36,
    movement_type: "smallfoot",
    movement: 5,
    experience: 42,
    level: 1,
    alignment: "lawful",
    cost: 14,
    children: [
      {
        tag: "attack",
        name: "spear",
        description: _("spear"),
        type: "pierce",
        range: "melee",
        damage: 7,
        number: 3,
        specials: "firststrike",
      },
    ],
  },
  {
    tag: "side",
    id: 1,
    controller: "human",
    gold: 75,
    income_base: 2,
    income_per_village: 1,
    recruit: "Spearman",
    leader: "Spearman",
    color: "#f6d365",
  },
  {
    tag: "side",
    id: 2,
    controller: "ai",
    gold: 75,
    recruit: "Spearman",
    color: "#b3a6dd",
  },
  {
    tag: "map",
    name: "Example",
    file: "maps/example.map",
  },
  // maps/example.map is plain text, one row per line:
  //   Gg,Gg,Gg,Gg,Gg,Gg,Gg
  //   Gg,Gg,1 Kh,Gg,Gg,Gg,Gg
  //   Gg,Ch,Ch,Ch,Ch,Gg,Gg
  //   Gg,Gg,Gg,Gg,Gg,Gg,Gg
  //   Gg,Gg,2 Kh,Gg,Gg,Gg,Gg
  {
    tag: "schedule",
    id: "default",
    children: [
      {
        tag: "time",
        id: "dawn",
        name: _("Dawn"),
        lawful_bonus: 0,
      },
      {
        tag: "time",
        id: "morning",
        name: _("Morning"),
        lawful_bonus: 25,
      },
      {
        tag: "time",
        id: "dusk",
        name: _("Dusk"),
        lawful_bonus: 0,
      },
      {
        tag: "time",
        id: "night",
        name: _("Night"),
        lawful_bonus: -25,
      },
    ],
  },
  {
    tag: "event",
    id: "victory_on_leader_death",
    on: "die",
    children: [
      {
        tag: "filter",
        side: 2,
        can_recruit: true,
      },
      {
        tag: "win",
        side: 1,
      },
    ],
  },
  {
    tag: "event",
    id: "first_contact",
    on: "moveto",
    children: [
      {
        tag: "filter",
        side: 1,
        x: 3,
        y: 2,
      },
      {
        tag: "dialogue",
        ref: "first_contact",
      },
    ],
  },
  {
    tag: "dialogue",
    id: "first_contact",
    children: [
      {
        tag: "say",
        speaker: "Spearman",
        text: _("The village is ours. Hold this line."),
      },
      {
        tag: "choice",
        text: _("Advance"),
        children: [
          {
            tag: "branch",
            children: [
              {
                tag: "message",
                speaker: "narrator",
                text: _("The line moves forward."),
              },
            ],
          },
          {
            tag: "branch",
            text: _("Hold"),
            children: [
              {
                tag: "message",
                speaker: "narrator",
                text: _("The line holds."),
              },
            ],
          },
        ],
      },
    ],
  },
  {
    tag: "objectives",
    children: [
      {
        tag: "victory",
        side: 1,
        condition: "units_dead",
        side_filter: 2,
      },
      {
        tag: "defeat",
        side: 1,
        condition: "units_dead",
        side_filter: 1,
      },
    ],
  },
  {
    tag: "save",
    version: 1,
    fields: "units,sides,gold,schedule_index,variables",
  },
]
