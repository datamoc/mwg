#textdomain example-skirmish
# The root document.
[game]
    schema=0.1
    title= _ "Example Skirmish"
    start_scene=skirmish
    default_schedule=default
[/game]

#define MEADOW_TERRAIN
[terrain_type]
    id=meadow
    string=Gg
    aliasof=flat
    base_tile=terrain/grass/green.png
[/terrain_type]
#enddef

{MEADOW_TERRAIN}

[terrain_type]
    id=village
    string=^Ve
    aliasof=_bas, village_base
    default_base=Gg
    heals=8
    gives_income=yes
    overlay_tile=terrain/village/camp-tile.png
[/terrain_type]

[movetype]
    name=smallfoot
    [movement_costs]
        flat=1
        forest=2
        hills=2
        village=1
    [/movement_costs]
    [defense]
        flat=60
        forest=50
        hills=50
        village=40
    [/defense]
    [resistance]
        blade=100
        pierce=100
        impact=100
        arcane=90
    [/resistance]
[/movetype]

[weapon_special]
    id=firststrike
    name= _ "firststrike"
[/weapon_special]

[unit_type]
    id=Spearman
    name= _ "Spearman"
    image=units/humans/spearman.png
    hitpoints=36
    movement_type=smallfoot
    movement=5
    experience=42
    level=1
    alignment=lawful
    cost=14
    [attack]
        name=spear
        description= _ "spear"
        type=pierce
        range=melee
        damage=7
        number=3
        specials=firststrike
    [/attack]
[/unit_type]

[side]
    id=1
    controller=human
    gold=75
    income_base=2
    income_per_village=1
    recruit=Spearman
    leader=Spearman
    color=#f6d365
[/side]

[side]
    id=2
    controller=ai
    gold=75
    recruit=Spearman
    color=#b3a6dd
[/side]

[map]
    name=Example
    file=maps/example.map
[/map]

# maps/example.map is plain text, one row per line:
#   Gg,Gg,Gg,Gg,Gg,Gg,Gg
#   Gg,Gg,1 Kh,Gg,Gg,Gg,Gg
#   Gg,Ch,Ch,Ch,Ch,Gg,Gg
#   Gg,Gg,Gg,Gg,Gg,Gg,Gg
#   Gg,Gg,2 Kh,Gg,Gg,Gg,Gg

[schedule]
    id=default
    [time]
        id=dawn
        name= _ "Dawn"
        lawful_bonus=0
    [/time]
    [time]
        id=morning
        name= _ "Morning"
        lawful_bonus=25
    [/time]
    [time]
        id=dusk
        name= _ "Dusk"
        lawful_bonus=0
    [/time]
    [time]
        id=night
        name= _ "Night"
        lawful_bonus=-25
    [/time]
[/schedule]

[event]
    id=victory_on_leader_death
    on=die
    [filter]
        side=2
        can_recruit=yes
    [/filter]
    [win]
        side=1
    [/win]
[/event]

[event]
    id=first_contact
    on=moveto
    [filter]
        side=1
        x=3
        y=2
    [/filter]
    [dialogue]
        ref=first_contact
    [/dialogue]
[/event]

[dialogue]
    id=first_contact
    [say]
        speaker=Spearman
        text= _ "The village is ours. Hold this line."
    [/say]
    [choice]
        text= _ "Advance"
        [branch]
            [message]
                speaker=narrator
                text= _ "The line moves forward."
            [/message]
        [/branch]
        [branch]
            text= _ "Hold"
            [message]
                speaker=narrator
                text= _ "The line holds."
            [/message]
        [/branch]
    [/choice]
[/dialogue]

[objectives]
    [victory]
        side=1
        condition=units_dead
        side_filter=2
    [/victory]
    [defeat]
        side=1
        condition=units_dead
        side_filter=1
    [/defeat]
[/objectives]

[save]
    version=1
    fields=units,sides,gold,schedule_index,variables
[/save]
