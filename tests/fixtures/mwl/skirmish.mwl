// textdomain: example-skirmish
// The root document.
#define MEADOW_TERRAIN
{ tag: 'terrain_type', id: 'meadow', string: 'Gg', aliasof: 'flat', base_tile: 'terrain/grass/green.png' }
#enddef

[
  {
    tag: "game",
    schema: 0.1,
    title: _("Example Skirmish"),
    start_scene: "skirmish",
    default_schedule: "default",
  },
  {MEADOW_TERRAIN},
  {
    tag: "terrain_type",
    id: "village",
    string: "^Ve",
